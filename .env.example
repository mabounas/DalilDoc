# ── API Keys ────────────────────────────────────────────────
# Claude Sonnet (génération)
ANTHROPIC_API_KEY=
# Whisper STT + Embeddings
OPENAI_API_KEY=
# TTS voix arabe
ELEVENLABS_API_KEY=

# ── Base de données ─────────────────────────────────────────
DB_USER=wathiqa
DB_PASSWORD=change-me
DATABASE_URL=postgresql://wathiqa:change-me@localhost:5432/wathiqadoc
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# ── Configuration ───────────────────────────────────────────
SUPPORTED_LANGUAGES=fr,ar,darija,en,pt,es
MAX_RESPONSE_TIME_MS=3000
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
MIN_CONFIDENCE=0.75
KIOSK_MODE=true

# ── Modèles ─────────────────────────────────────────────────
LLM_MODEL=claude-sonnet-5
EMBEDDING_MODEL=text-embedding-3-small
STT_MODEL=whisper-1
TTS_MODEL=eleven_multilingual_v2

# ── Mode local sans clés (dev / borne hors ligne) ───────────
# "auto"  : utilise les API si les clés sont présentes, sinon moteur local
# "local" : force le moteur local (retrieval lexical + réponse extractive)
RAG_MODE=auto

# ── Admin ───────────────────────────────────────────────────
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRE_HOURS=8
REFRESH_EXPIRE_DAYS=7
ADMIN_BOOTSTRAP_EMAIL=admin@wathiqadoc.ma
ADMIN_BOOTSTRAP_PASSWORD=change-me

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
